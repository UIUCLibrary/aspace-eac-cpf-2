 "notes": [
  {
   "jsonmodel_type": "note_bioghist",
   "label": "Historical Note",
   "persistent_id": "707ba2c38b90c34f5024c0fd6f777bea",
   "publish": true,
   "subnotes": [
    {
     "content": "On January 8, 1948, the Board of Trustees authorized the purchase of an EDVAC electronic digital computer for research program use.<emph render='super'>1 </emph>On November 19, 1948, the Board approved space for the computer project.<emph render='super'>2 </emph>On January 13, 1949, the Board reallocated funds to university staff for construction of the computer.<emph render='super'>3 </emph>By July 16, 1952, the Digital Computer Laboratory was listed in the university budget.<emph render='super'>4 </emph>In 1954, the laboratory offered \"instruction in courses and supervision of theses for individuals specializing in the design and use of the digital computing machinery.\"<emph render='super'>5 </emph>In 1964, the name was changed from the Digital Computer Laboratory to the Department of Computer Science.<emph render='super'>6</emph> The department teaches courses in circuit design, computer applications, computer organization, digital computer arithmetic, information retrieval, languages, numerical analysis, patters recognition, software systems, and switching an automata theory.<emph render='super'>7</emph>\n\t1. Board of Trustees Transactions, 44th Report, January 8, 1948, p. 954.\n\t2. Board of Trustees Transactions, 45th Report, November 19, 1948, p. 172.\n\t3. Board of Trustees Transactions, 45th Report, January 13, 1949, p. 204.\n\t4. Board of Trustees Transactions, 47th Report, July 16, 1952, p. 145.\n\t5. Graduate College Catalog, 1954-56, p. 29.\n\t6. Board of Trustees Transactions, 53rd Report, November 24, 1964, p. 240.\n\t7. Graduate Programs, 1972-1974, p. 59.",
     "jsonmodel_type": "note_text",
     "publish": true
    }
   ]
  },
